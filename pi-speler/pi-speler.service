[Unit]
Description=Pi-speler: fragmentknoppen, gids en stop
After=sound.target
Wants=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Root: de groene ACT-led (/sys/class/leds/ACT) vraagt schrijfrechten.
User=root
WorkingDirectory=@DIR@
ExecStart=@DIR@/start.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
