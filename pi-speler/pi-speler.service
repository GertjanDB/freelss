[Unit]
Description=Pi-speler: knoppen A en B naar de koptelefoonuitgang
After=sound.target
Wants=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStart=@DIR@/start.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
