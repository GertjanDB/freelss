[Unit]
Description=Pi-speler: 18 knoppen naar de koptelefoonuitgang
After=sound.target
Wants=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -u "@DIR@/pi_speler.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
